{
  "name": "slowen",
  "version": "0.0.0",
  "scripts": {
    "start": "npm run build:electron && concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "build": "ng build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:prod": "ng build --configuration production",
    "electron:dev": "npm run build:electron && electron .",
    "dist": "npm run build:electron && npm run build:prod && electron-builder --mac",
    "test": "ng test",
    "test:electron": "vitest run electron/database/accounts.spec.ts electron/database/bookings.spec.ts electron/database/connection.spec.ts electron/database/depot-positions.spec.ts electron/ipc/depot-positions.ipc.spec.ts src/app/models/booking.model.spec.ts src/app/models/depot-position.model.spec.ts",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "main": "dist-electron/electron/main.js",
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "better-sqlite3": "^13.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^8.0.3"
  }
}
